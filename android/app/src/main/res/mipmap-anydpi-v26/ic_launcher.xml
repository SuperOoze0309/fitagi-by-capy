<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive icon (Android 8+).

  The cat sketch is a JPEG with no transparency, so it lives in the BACKGROUND layer:
  as a foreground layer its own white square would sit on top of the background colour
  and the seam would be visible. Full bleed in the background, the launcher's mask
  crops paper rather than the cat.

  The foreground is a transparent image, because the descriptor expects one and a
  second copy of the artwork would only double-draw it.

  Generated by design/icon-candidates/render-android-icons.ps1 - run that instead of
  editing the PNGs by hand.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@mipmap/ic_launcher_background"/>
    <foreground android:drawable="@mipmap/ic_launcher_foreground"/>
</adaptive-icon>
