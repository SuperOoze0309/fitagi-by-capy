{
  "name": "fitagi-by-capy",
  "private": true,
  "version": "0.9.0",
  "description": "FitAGI by Capy - local-first, open-source workout and meal tracker for Android. No account, no server, offline by default.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "node --test --experimental-transform-types --import ./scripts/register-ts.mjs \"src/**/*.test.ts\"",
    "test:browser": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/smoke.ps1",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run build",
    "cap:sync": "cap sync android",
    "cap:copy": "cap copy android",
    "android:apk": "npm run build && cap sync android && cd android && gradlew.bat assembleDebug"
  },
  "dependencies": {
    "@capacitor-community/sqlite": "^7.0.3",
    "@capacitor/android": "^7.0.0",
    "@capacitor/app": "^7.0.0",
    "@capacitor/camera": "^7.0.5",
    "@capacitor/core": "^7.0.0",
    "@capacitor/filesystem": "^7.0.0",
    "@capacitor/local-notifications": "^7.0.7",
    "@capacitor/share": "^7.0.0",
    "@capacitor/status-bar": "^7.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.0.0",
    "@eslint/js": "^9.17.0",
    "@types/node": "^26.6.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "fake-indexeddb": "^6.2.5",
    "globals": "^15.14.0",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.18.2",
    "vite": "^6.0.7"
  }
}
